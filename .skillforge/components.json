    },
    "cleanup": {
      "paths": [
        ".github/scripts/cleanup_issue_worktrees.py",
        ".github/scripts/test_worktree_cleanup.py"
      ],
      "depends_on": [],
      "checks": ["cleanup"]
    },
    "runners": {
      "paths": [
        ".github/scripts/codex_profile.py",
        ".github/scripts/devin_host_broker.py",
        ".github/scripts/devin_host_client.py",
        ".github/scripts/devin_runner.py",
        ".github/scripts/executor_control.py",
        ".github/scripts/local_issue_worktree.py",
        ".github/scripts/prepare_pr_audit.py",
        ".github/scripts/test_codex_profile.py",
        ".github/scripts/test_executor_routing.py",
        ".github/scripts/test_canonical_template.py",
        "skills/codex-local-runner/",
        "skills/devin-local-runner/",
        "skills/execution-runner-selection/"
      ],
      "depends_on": [],
      "checks": ["routing", "profiles", "template"]
    }
  }
}
