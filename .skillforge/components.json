{
  "version": 1,
  "global_paths": [
    ".codex/",
    ".github/actionlint.yaml",
    "README.md",
    "docs/",
    "skills/codex-github-operations/",
    "skills/codex-pr-audit/",
    "skills/codex-independent-review/",
    "skills/spec-driven-codex-loop/",
    "skills/test-quality/"
  ],
  "components": {
    "epics": {
      "paths": [
        "skills/codex-epic-scheduler/",
        ".github/scripts/find_epic_parent.py",
        ".github/scripts/test_epic_scheduler.py"
      ],
      "depends_on": [],
